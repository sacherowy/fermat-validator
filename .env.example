# FerMat Validator Development Environment
# Copy this to .env and fill in the required values

# =============================================================================
# REQUIRED
# =============================================================================

# AI Provider - Gemini API key is required
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3-pro-preview
GEMINI_TIMEOUT=90
GEMINI_THINKING_LEVEL=low
GEMINI_MEDIA_RESOLUTION=high
GEMINI_MEDIA_RESOLUTION_IMAGES=ultra_high

# =============================================================================
# AUTHENTICATION (optional for local dev)
# =============================================================================

# Disable authentication for local development (Google OAuth requires external URL)
AUTH_DISABLED=true

# Session secret (generate for production: openssl rand -hex 32)
SESSION_SECRET_KEY=dev-secret-key-change-in-production

# Google OAuth (required when AUTH_DISABLED=false)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# ACCESS CONTROL (required when AUTH_DISABLED=false)
# =============================================================================

# Option 1: Email allowlist (simplest - comma-separated list)
# ALLOWED_EMAILS=user1@gmail.com,user2@example.com

# Option 2: Public access with rate limits
# PUBLIC_ACCESS=true

# Option 3: Google Groups API (requires Workspace Admin + Domain-Wide Delegation)
# GOOGLE_GROUP_EMAIL=your-group@googlegroups.com
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Admin users (comma-separated)
# ADMIN_EMAILS=admin@gmail.com

# =============================================================================
# RATE LIMITING (rolling 24h, optional)
# =============================================================================
# RATE_LIMIT_NEW_USERS_PER_DAY=50
# RATE_LIMIT_SUBMISSIONS_PER_USER_PER_DAY=30
# RATE_LIMIT_SUBMISSIONS_GLOBAL_PER_DAY=500

# =============================================================================
# TRANSLATION (EN→PL status messages, optional)
# =============================================================================
# TRANSLATE_ENABLED=true
# TRANSLATE_API_KEY=your-google-translate-api-key
# TRANSLATE_TIMEOUT=2.0

# =============================================================================
# DATABASE (set automatically by docker-compose.yml for containers)
# =============================================================================
# Only uncomment if running backend outside of Docker:
# DATABASE_URL=postgresql://fermat:fermat@localhost:5433/fermat
